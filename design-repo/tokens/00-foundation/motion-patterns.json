{
  "$description": "Closed set of motion patterns observed in the motion layer. A PageSpec node may only use a pattern its section contract allows; reducedMotionFallback is locked per pattern.",
  "version": "1.0.0",
  "patterns": {
    "intro-loader-seal": {
      "id": "intro-loader-seal",
      "description": "Once-per-session intro: seal draws, counter 00->100, status line steps, seal stamps, 6 night panels wipe up and off.",
      "evidence": [
        {
          "cite": "public/assets/js/site.js:899-944",
          "expect": "function loader(onReveal)"
        },
        {
          "cite": "index.html:28-38",
          "expect": "sessionStorage.getItem('dc-intro')"
        }
      ],
      "reducedMotionFallback": "skip-entirely",
      "library": "anime.js 4.5 timeline (not GSAP): A.createTimeline defaults ease inOut(3); draws via A.svg.createDrawable",
      "timeline": [
        {
          "t": 0,
          "target": ".seal-draw x3",
          "prop": "draw",
          "from": "0 0",
          "to": "0 1",
          "durationMs": 1250,
          "staggerMs": 160,
          "ease": "inOut(3)"
        },
        {
          "t": 0,
          "target": "counter + .loader__bar span",
          "prop": "value 0->100 (2-digit pad); bar scaleX v/100",
          "durationMs": 1750,
          "ease": "inOut(2)",
          "statusThresholds": [
            [
              0,
              "status 0"
            ],
            [
              22,
              "status 1"
            ],
            [
              48,
              "status 2"
            ],
            [
              74,
              "status 3"
            ],
            [
              96,
              "status 4"
            ]
          ]
        },
        {
          "t": 850,
          "target": ".seal-text",
          "prop": "opacity",
          "from": 0,
          "to": 1,
          "durationMs": 600,
          "ease": "outQuad"
        },
        {
          "t": 1650,
          "target": ".loader__seal",
          "prop": "scale [1,.9,1.02,1], rotate 0->-8deg",
          "durationMs": 520,
          "ease": "outQuad",
          "restState": "rotate(-8deg) scale(1)"
        },
        {
          "t": 1700,
          "target": ".seal-ink",
          "prop": "opacity 0->0.12, scale .6->1",
          "durationMs": 420,
          "ease": "outQuad"
        },
        {
          "t": 2050,
          "target": ".loader__panels i x6",
          "prop": "scaleY",
          "from": 0,
          "to": 1,
          "durationMs": 650,
          "staggerMs": 55,
          "ease": "inOut(4)",
          "transformOrigin": "50% 100%"
        },
        {
          "t": 2780,
          "target": "top/mid/bot/bar",
          "prop": "visibility hidden; loader background transparent; page intro (hero-intro-stagger) starts",
          "call": true
        },
        {
          "t": 2800,
          "target": ".loader__panels i x6",
          "prop": "translateY",
          "from": "0%",
          "to": "-101%",
          "durationMs": 800,
          "staggerMs": 55,
          "ease": "inOut(4)"
        },
        {
          "t": 3700,
          "target": ".loader",
          "prop": "display:none; smooth scroll restarted; sessionStorage dc-intro=1",
          "call": true
        }
      ],
      "t0": "T0 = html gets is-ready, after document.fonts.ready (raced against 2500ms) and all ScrollTriggers are built; measured ~1134ms after navigation on the live site, ~815ms on the clone",
      "gating": {
        "oncePerSession": "sessionStorage['dc-intro']==='1' -> html.no-loader (head inline script)",
        "reducedMotion": "prefers-reduced-motion: reduce -> html.no-loader, loader never shown",
        "safetyNetMs": 6000,
        "safetyNet": "if html never gets is-ready within 6000ms: add no-loader, remove js (everything visible)",
        "noJs": ".loader{display:none} unless html.js",
        "scrollLock": "lenis.stop() + html.lenis-stopped while playing"
      },
      "measured": {
        "live": {
          "isReadyMs": 1134,
          "statusChangesAbsMs": [
            1711,
            1981,
            2253,
            2641
          ],
          "panelsStartAbsMs": 3211,
          "bgTransparentAbsMs": 3943,
          "panelsOffAbsMs": 4711,
          "displayNoneAbsMs": 4843,
          "sessionFlagAbsMs": 4843
        },
        "clone": {
          "isReadyMs": 815,
          "statusChangesAbsMs": [
            1381,
            1653,
            1920,
            2315
          ],
          "panelsStartAbsMs": 2850
        },
        "source": "extraction/measured-values.json loader.timelineLog"
      }
    },
